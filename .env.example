# Set these in Vercel's Environment Variables (not in this file — .env is gitignored)

# Muse Glimmer — required, this is the free default visitors use with no key of their own
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=your-muse-glimmer-deployment-id
LLM_API_KEY=your-nvidia-api-key

# Optional — only change these if you want a different default model id for
# visitors who bring their own Anthropic/OpenAI/Gemini key. No key goes here;
# visitors supply their own in the app.
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash
