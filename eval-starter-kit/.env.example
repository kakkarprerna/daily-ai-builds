# Default model: Meta Muse Glimmer 30B on NVIDIA's free endpoint (runs on your key)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=
LLM_API_KEY=

# Optional model overrides for bring-your-own-key providers (visitors supply the keys)
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.5-flash
