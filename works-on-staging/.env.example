# Environment keys for Works on Staging. Set these in Vercel > Project > Settings > Environment Variables.

# Default model: Meta Muse Glimmer 30B on NVIDIA's OpenAI-shaped endpoint (the owner's key).
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=
LLM_API_KEY=

# Optional model overrides for visitors who bring their own key.
# Anthropic, OpenAI and Gemini have no server-side key: visitors must paste their own.
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-5-mini
GEMINI_MODEL=gemini-2.5-flash
