# Default provider: Meta Muse Glimmer 30B on NVIDIA's free endpoint (OpenAI-shaped)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=paste-the-exact-muse-glimmer-model-id-from-your-nvidia-dashboard
LLM_API_KEY=nvapi-your-key-here

# Optional: a vision-capable model on the same endpoint, used only for photos.
# Leave empty and photos on the default provider will ask the reader to paste the
# text or switch to their own Anthropic, OpenAI or Gemini key. PDFs always need
# a visitor key, because the free endpoint does not read them.
LLM_VISION_MODEL=
