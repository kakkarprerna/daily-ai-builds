# Default provider: Meta Muse Glimmer 30B on NVIDIA's free endpoint (OpenAI-shaped)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=paste-the-exact-muse-glimmer-model-id-from-your-nvidia-dashboard
LLM_API_KEY=nvapi-your-key-here

# Optional: a vision-capable model on the same endpoint, used only for label photos.
# Leave empty and photo checks on the default provider will ask the visitor to type
# the ingredients or switch to their own Anthropic, OpenAI or Gemini key.
LLM_VISION_MODEL=
