# Muse Glimmer on NVIDIA's free endpoint (your key, used when a visitor leaves the key field blank)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=your-muse-glimmer-model-id
LLM_API_KEY=nvapi-...
# Optional default model names for bring-your-own-key providers
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.5-flash
