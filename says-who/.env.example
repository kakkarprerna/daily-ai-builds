# Default model: Meta Muse Glimmer 30B on NVIDIA's free endpoint (OpenAI-shaped)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=your-muse-glimmer-model-id
LLM_API_KEY=your-nvidia-key

# Optional model overrides for bring-your-own-key visitors
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-4.1
GEMINI_MODEL=gemini-2.5-flash
