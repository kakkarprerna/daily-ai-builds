# Used only by the "Free, built in" provider option (Muse Glimmer on NVIDIA's endpoint).
# Anthropic, OpenAI and Gemini are bring-your-own-key from the visitor, so they need no env vars here.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/muse-glimmer-30b
LLM_API_KEY=your-nvidia-key-here

# Use the same three values you already have set on your other daily-build
# projects (Dígame, Pattern or One-off, etc). Copying them here is enough.
